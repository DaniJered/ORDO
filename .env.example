# Server & Environment
ENVIRONMENT=development
PORT=8000
SECRET_KEY=ordo-dev-secret-key-32-characters-minimum-for-security-entropy!
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (Postgres in Docker, SQLite fallback in local dev)
DATABASE_URL=sqlite:///./ordo.db
# For PostgreSQL:
# DATABASE_URL=postgresql+psycopg://ordo:ordo_secret@localhost:5432/ordo_db

# Integrations
MOCK_INTEGRATIONS=true
KILL_SWITCH_ACTIVE=false

# SMTP / Email
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@ordo.college

# WhatsApp Cloud API (Mock mode default)
WHATSAPP_MOCK_MODE=true
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# AI Provider (mock, gemini, openai)
AI_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=

